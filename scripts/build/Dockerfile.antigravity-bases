# Add a reviewed Google CLI release to the matching Rocky dependency bases.
ARG BUILD_BASE=hiforceai/panda-force-build-base@sha256:963bf3d085b78419caec7f5a2a53323c012956e334c716e3754cd744bfb4b1e3
ARG RUNTIME_BASE=hiforceai/panda-force-runtime-base@sha256:ce564a38e60c4119cd4addd7f9cda11fd3accefa72a4fb7ad6978800a37a86ba
FROM ${RUNTIME_BASE} AS antigravity
USER root
COPY antigravity-runtime.lock.json cli_linux_x64.tar.gz /tmp/antigravity-inputs/
RUN . /etc/os-release && test "$ID" = rocky && test "${VERSION_ID%%.*}" = 9 \
    && test "$(uname -m)" = x86_64 \
    && cd /tmp/antigravity-inputs \
    && node -e 'const p=require("./antigravity-runtime.lock.json");if(p.schema!==1||p.platform!=="linux/amd64"||!/^[a-f0-9]{128}$/.test(p.sha512))process.exit(1);console.log(p.sha512+"  cli_linux_x64.tar.gz")' > checksums.txt \
    && sha512sum --check checksums.txt \
    && mkdir -p /opt/panda-antigravity \
    && tar -xOzf cli_linux_x64.tar.gz antigravity > /opt/panda-antigravity/agy \
    && chmod 0755 /opt/panda-antigravity/agy \
    && install -m 0644 antigravity-runtime.lock.json /opt/panda-antigravity/release.json \
    && HOME=/tmp /opt/panda-antigravity/agy --version | grep -Fx "$(node -p 'require("./antigravity-runtime.lock.json").version')" \
    && HOME=/tmp /opt/panda-antigravity/agy acp --help > acp-help.txt 2>&1 \
    && grep -F -- '--login' acp-help.txt

FROM ${BUILD_BASE} AS build-base
USER root
COPY --from=antigravity /opt/panda-antigravity /opt/panda-antigravity
RUN ln -s /opt/panda-antigravity/agy /usr/local/bin/agy

FROM ${RUNTIME_BASE} AS runtime-base
USER root
COPY --from=antigravity /opt/panda-antigravity /opt/panda-antigravity
RUN ln -s /opt/panda-antigravity/agy /usr/local/bin/agy
