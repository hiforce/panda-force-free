# Add the original, reviewed Claude Code CLI and ACP adapter to an operator-selected Rocky pair.
ARG BUILD_BASE
ARG RUNTIME_BASE

FROM ${RUNTIME_BASE} AS claude-tools
USER root
COPY claude-runtime.mjs /tmp/claude-runtime.mjs
COPY tools/ /opt/panda-claude/
RUN . /etc/os-release && test "$ID" = rocky && test "${VERSION_ID%%.*}" = 9 && test "$(uname -m)" = x86_64 \
    && chmod -R a+rX /opt/panda-claude/node_modules \
    && node /tmp/claude-runtime.mjs verify /opt/panda-claude \
    && HOME=/tmp /opt/panda-claude/claude --version | grep -qFx "$(node -p 'require("/opt/panda-claude/runtime.lock.json").claude.version') (Claude Code)" \
    && HOME=/tmp /opt/panda-claude/node_modules/.bin/claude-agent-acp --version | grep -Fx "$(node -p 'require("/opt/panda-claude/runtime.lock.json").adapter.version')" \
    && printf '#!/bin/sh\nexport CLAUDE_CODE_EXECUTABLE="${CLAUDE_CODE_EXECUTABLE:-/opt/panda-claude/claude}"\nexec /opt/panda-claude/node_modules/.bin/claude-agent-acp "$@"\n' > /opt/panda-claude/claude-agent-acp \
    && chmod 0755 /opt/panda-claude/claude-agent-acp

FROM ${BUILD_BASE} AS build-base
USER root
COPY --link --from=claude-tools /opt/panda-claude /opt/panda-claude
RUN ln -s /opt/panda-claude/claude /usr/local/bin/claude \
    && ln -s /opt/panda-claude/claude-agent-acp /usr/local/bin/claude-agent-acp

FROM ${RUNTIME_BASE} AS runtime-base
USER root
COPY --link --from=claude-tools /opt/panda-claude /opt/panda-claude
RUN ln -s /opt/panda-claude/claude /usr/local/bin/claude \
    && ln -s /opt/panda-claude/claude-agent-acp /usr/local/bin/claude-agent-acp
