  "live": [
    {
      "file": "live/account-api.e2e.mjs",
      "requires": "A deliberately configured local authenticated account on port 8899; provider privacy diagnostic."
    },
    {
      "file": "live/approval.e2e.mjs",
      "requires": "A disposable authenticated local real CLI on port 8899; executes a native command."
    },
    {
      "file": "live/review-api.e2e.mjs",
      "requires": "A disposable local review server on port 8899; exercises patch routes."
    },
    {
      "file": "live/oss-attachments.e2e.mjs",
      "requires": "PANDA_FORCE_OSS_TEST_CONFIG points to a private disposable OSS test configuration."
    },
    {
      "file": "live/clipboard-oss-native.e2e.mjs",
      "requires": "A disposable authenticated CLI and private OSS test configuration; native image input."
    },
    {
      "file": "live/app-server.live.test.ts",
      "requires": "A deliberately configured disposable authenticated Codex CLI account; reads its model/session catalog and executes one harmless real model turn. Never required for image builds."
    }
  ],
  "tooling": [
    {
      "file": "tooling/search-vector-compose.e2e.mjs",
      "requires": "Explicit local Milvus image in PANDA_FORCE_MILVUS_TEST_IMAGE and a Docker Compose daemon. Uses isolated credentials, named volumes and synthetic vectors; verifies authentication, real CRUD and restart without model inference or production changes.",
      "timeoutMs": 480000
    },
    {
      "file": "tooling/application-tools.e2e.mjs",
      "requires": "An explicitly installed Codex CLI. Starts a temporary Unix-socket app server with an empty model home and a deterministic loopback provider; verifies application tool isolation and real file/Git output without production credentials, external model calls or article publication.",
      "timeoutMs": 120000
    },
    {
      "file": "tooling/sftp-publication.e2e.mjs",
      "requires": "Root, local OpenSSH server and ssh-keygen. Starts an isolated loopback SFTP chroot with disposable keys, publishes only fixture content and removes the daemon and files afterwards. No production hosts or credentials.",
      "timeoutMs": 120000
    },
    {
      "file": "tooling/dev-watch.e2e.mjs",
      "requires": "Run separately: modifies and restores tracked source timestamps to test the development watcher."
    },
    {
      "file": "tooling/document-executor.e2e.mjs",
      "requires": "A local Linux Docker daemon and verified application, executor and worker images supplied by PANDA_FORCE_APP_TEST_IMAGE, PANDA_FORCE_EXECUTOR_TEST_IMAGE and PANDA_FORCE_WORKER_TEST_IMAGE. Uses disposable Compose services and local mirror aliases, never Kubernetes or real publishing credentials.",
      "timeoutMs": 600000
    },
    {
      "file": "tooling/site-build-compose.e2e.mjs",
      "requires": "A local Linux Docker daemon and application, executor and worker images in PANDA_FORCE_APP_TEST_IMAGE, PANDA_FORCE_EXECUTOR_TEST_IMAGE and PANDA_FORCE_WORKER_TEST_IMAGE. Exercises the complete saved-document build flow through disposable Compose services; no Kubernetes, production credentials or real publication.",
      "timeoutMs": 600000
    },
    {
      "file": "tooling/document-ingestion-engines.e2e.mjs",
      "timeoutMs": 360000
    },
    {
      "file": "tooling/trusted-themes.e2e.mjs",
      "timeoutMs": 360000,
      "requires": "Requires an explicitly selected local Docker worker image; runs disposable no-network executable theme builds."
    },
    {
      "file": "tooling/source-profile-engine.e2e.mjs",
      "timeoutMs": 360000,
      "requires": "Explicit local worker image and read-only source project, theme and edition config files. Reads authorized source files only, stores disposable state, runs no-network isolated builds and writes no publication targets. Optional private evidence directory."
    },
    {
      "file": "tooling/project-document-engines.e2e.mjs",
      "timeoutMs": 360000,
      "requires": "An explicitly selected verified local Docker worker image. Builds canonical legacy and file-backed rich project documents through Hexo and Docusaurus in disposable no-network containers, with no host mounts, model credentials or real publication."
    },
    {
      "file": "tooling/site-theme-profiles.e2e.mjs",
      "timeoutMs": 360000,
      "requires": "An explicitly selected local worker image. Builds fixed built-in and configurable profile samples for both engines in disposable read-only no-network workers; no host mounts, account credentials or article publication."
    },
    {
      "file": "tooling/cli-agent-clients.e2e.mjs",
      "requires": "Explicitly installed Codex and Claude CLIs. Uses isolated client homes, registered synthetic Panda credentials and loopback HTTP; verifies native MCP discovery and missing-key denial without model inference or production configuration changes.",
      "timeoutMs": 120000
    },
    {
      "file": "tooling/cli-offline-package.e2e.mjs",
      "requires": "Node.js 22 or later; creates a disposable offline package and isolated CLI home.",
      "timeoutMs": 120000
    }
  ]
