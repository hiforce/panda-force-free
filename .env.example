# PandaForce starts locally and creates its administrator in the browser.
HOST=127.0.0.1
PORT=8899
# PANDA_FORCE_HOME=/absolute/path/to/private/state
# PANDA_FORCE_CWD=/absolute/path/to/workspace
# Managed project workspaces are available in version 0.0.15 and later.
# Container paths must be backed by persistent mounts; shared engines need the same absolute path.
# PANDA_FORCE_PROJECTS_ROOT=/absolute/path/to/projects
# PANDA_FORCE_ALLOW_EXTERNAL_DIRECTORIES=true
# PANDA_FORCE_ATTACHMENT_STORAGE=local
# PANDA_FORCE_ATTACHMENT_ROOT=/absolute/path/to/private/attachments
# PANDA_FORCE_LOG_MAX_BYTES=10485760
# PANDA_FORCE_LOG_MAX_FILES=10
# PANDA_FORCE_IMAGE=registry.example.com/team/panda-force:VERSION
# PANDA_FORCE_PLATFORM=linux/amd64
# PANDA_FORCE_BIND_IP=127.0.0.1
# PANDA_FORCE_PORT=8899
# PANDA_FORCE_MODEL_HOME_HOST=/absolute/path/to/model-state
# PANDA_FORCE_WORKSPACE_HOST=/absolute/path/to/workspace
# Optional: reuse existing Docker volumes by their actual names.
# PANDA_FORCE_STATE_VOLUME_NAME=
# PANDA_FORCE_MODEL_VOLUME_NAME=
# PANDA_FORCE_WORKSPACE_VOLUME_NAME=
# Optional compatible dependency bases, including administrator-managed registries.
# PANDA_FORCE_BUILD_BASE=registry.example.com/team/panda-build:VERSION
# PANDA_FORCE_RUNTIME_BASE=registry.example.com/team/panda-runtime:VERSION
# PANDA_FORCE_VERIFICATION_PROFILE=none

# Optional Grok Build account service; use the Grok Compose overlay in the installation guide.
# All application/auth services default to the same 0.1.4 image.
# PANDA_FORCE_PULL_POLICY=missing
# PANDA_FORCE_GROK_ACCOUNT_HOME_HOST=/absolute/operator-owned/grok-account
# Leave the host account path unset to use a private named volume on Linux/Docker Desktop.

# Optional ZCode overlay: point to your private provider JSON outside this checkout.
# PANDA_FORCE_ZCODE_PROVIDER_FILE=/absolute/path/to/zcode-provider.json
