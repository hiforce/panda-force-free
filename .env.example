# Local-only listening and local uploads are the defaults.
HOST=127.0.0.1
PORT=8899
# First run creates an administrator in the browser; no preset password is needed.
# PANDA_FORCE_HOME=/absolute/path/to/private/panda-force-state
# CODEX_WEBUI_CWD=/absolute/path/to/workspace
# CODEX_WEBUI_ATTACHMENT_STORAGE=local
# CODEX_WEBUI_ATTACHMENT_ROOT=/absolute/path/to/private/uploads
# Docker named volumes keep state across container restarts.
# WEBUI_BIND_IP=127.0.0.1
# WEBUI_PORT=8899
# PUID=1000
# PGID=1000
