{
  "name": "panda-force-free",
  "version": "0.0.13",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run scripts/start.ts",
    "dev": "bun run scripts/dev.ts",
    "build": "bun run build:client && bun run build:server",
    "check": "bun run check:dependencies && bun run check:contracts && bun run check:state && bun run typecheck && bun run check:dom && bun run check:build",
    "test": "bun scripts/testing/run.mjs unit",
    "test:unit": "bun scripts/testing/run.mjs unit",
    "test:integration": "bun scripts/testing/run.mjs integration",
    "test:browser": "bun scripts/testing/run.mjs browser",
    "test:e2e": "bun scripts/testing/run.mjs browser",
    "test:browser:failure-paths": "bun scripts/testing/run.mjs failure-paths",
    "build:client": "bun scripts/build-client.mjs",
    "build:server": "bun build src/server/main.ts --target=bun --outfile=dist/server.js && bun build src/server/terminal/worker.js --target=node --external=node-pty --outfile=dist/worker.js && bun build scripts/start.ts --target=bun --outfile=dist/start.js && bun build src/server/cluster/gateway.ts --target=bun --outfile=dist/gateway.js",
    "test:browser:runtime": "bun scripts/testing/run.mjs runtime",
    "test:architecture": "bun test tests/unit/client-architecture.test.ts",
    "test:browser:i1": "bun scripts/testing/run.mjs workbench",
    "test:browser:projects": "bun scripts/testing/run.mjs projects",
    "release:comments": "bun scripts/release/comment-audit.mjs",
    "release:export": "bun scripts/release/export-free.mjs",
    "release:verify": "bun scripts/release/verify-free.mjs",
    "verify": "bun scripts/testing/run.mjs verify",
    "test:live": "bun scripts/testing/run.mjs live",
    "check:i18n": "bun scripts/i18n/validate.mjs",
    "check:build": "bun build src/server/main.ts --target=bun --outfile=/tmp/panda-force-server-check.js && bun build scripts/dev.ts --target=bun --outfile=/tmp/panda-force-dev-check.js && bun build src/client/app.js --target=browser --outfile=/tmp/panda-force-app-check.js --external=/file-preview.bundle.js --external=/terminal-runtime.bundle.js && bun build scripts/start.ts --target=bun --outfile=/tmp/panda-force-start-check.js && bun build src/server/cluster/gateway.ts --target=bun --outfile=/tmp/panda-force-gateway-check.js",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json && bun node_modules/typescript/bin/tsc -p tsconfig.strict.json && bun node_modules/typescript/bin/tsc -p tsconfig.contracts.json && bun node_modules/typescript/bin/tsc -p tsconfig.tooling.json",
    "check:dom": "bun scripts/quality/dom-types.mjs",
    "lint": "bun node_modules/eslint/bin/eslint.js src scripts tests *.mjs --max-warnings 0",
    "format": "bun scripts/quality/format.mjs --write",
    "format:check": "bun scripts/quality/format.mjs",
    "check:dependencies": "bun scripts/quality/dependencies.mjs",
    "check:state": "bun scripts/quality/state-contracts.ts",
    "check:contracts": "bun scripts/quality/contracts.ts",
    "release:proof": "bun scripts/verification/build-proof.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ali-oss": "^6.23.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "i18next": "26.7.1",
    "i18next-icu": "2.6.1",
    "immer": "11.2.9",
    "intl-messageformat": "12.1.4",
    "katex": "^0.18.2",
    "marked": "^16.4.2",
    "node-pty": "^1.1.0",
    "proxy-agent": "^8.0.2",
    "sharp": "^0.35.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@types/jsdom": "^21",
    "@types/katex": "0.16.8",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "acorn": "^8.15.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.72.1"
  },
  "patchedDependencies": {
    "urllib@2.44.1": "patches/urllib@2.44.1.patch"
  },
  "overrides": {
    "basic-ftp": "^6.2.5"
  },
  "repository": "github:hiforce/panda-force-free",
  "bugs": "https://github.com/hiforce/panda-force-free/issues",
  "homepage": "https://github.com/hiforce/panda-force-free#readme"
}
