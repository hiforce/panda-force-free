# PandaForce starts locally and creates its administrator in the browser.
HOST=127.0.0.1
PORT=8899
# PANDA_FORCE_HOME=/absolute/path/to/private/state
# PANDA_FORCE_CWD=/absolute/path/to/workspace
# PANDA_FORCE_ATTACHMENT_STORAGE=local
# PANDA_FORCE_ATTACHMENT_ROOT=/absolute/path/to/private/attachments
# PANDA_FORCE_LOG_MAX_BYTES=10485760
# PANDA_FORCE_LOG_MAX_FILES=10
# PANDA_FORCE_IMAGE=registry.example.com/team/panda-force:VERSION
# Optional: reuse existing Docker volumes by their actual names.
# PANDA_FORCE_STATE_VOLUME_NAME=
# PANDA_FORCE_MODEL_VOLUME_NAME=
# PANDA_FORCE_WORKSPACE_VOLUME_NAME=
